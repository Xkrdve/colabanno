# Copier en .env pour le dev local (voir scripts/dev-db.ts pour Postgres embarque)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/instanceseg
JWT_SECRET=change-me-in-production-min-32-chars-long
PORT=4000
WS_PORT=4001
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
# En dev sandbox sans Docker: demarrer Postgres embarque automatiquement (scripts/dev-db.ts)
EMBEDDED_PG=1
EMBEDDED_PG_PORT=55432
EMBEDDED_PG_DIR=./.pgdata
# Export automatique periodique (cron-like, minutes; 0 = desactive)
AUTO_EXPORT_ENABLED=0
AUTO_EXPORT_INTERVAL_MIN=60
TRASH_RETENTION_DAYS=7
