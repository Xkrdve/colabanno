    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.3",
    "@types/uuid": "10.0.0",
    "@types/ws": "8.5.14",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "embedded-postgres": "18.1.0-beta.16",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "pg": "8.13.1",
    "sharp": "0.33.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "uuid": "11.0.3",
    "ws": "8.18.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "playwright-core": "1.49.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1",
    "vite": "6.0.7"
  }
