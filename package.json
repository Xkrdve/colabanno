{
  "name": "instanceseg-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Annotation collaborative d'images pour la segmentation d'instances (5 postes, PostgreSQL, React+TS)",
  "type": "module",
  "scripts": {
    "dev:db": "tsx scripts/dev-db.ts",
    "dev:server": "tsx src/server/index.ts",
    "dev:client": "vite client",
    "dev": "node scripts/dev-all.mjs",
    "build": "tsc -p tsconfig.server.json && vite build client",
    "start": "node dist/server/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "e2e": "tsx scripts/e2e-demo.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
